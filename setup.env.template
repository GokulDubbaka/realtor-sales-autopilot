# ── ADB CONFIG ──────────────────────────────────────────────────────
# Leave as default unless you have multiple phones connected
ADB_PATH=./platform-tools/adb.exe
ADB_DEVICE=                        # Leave blank to auto-detect first device

# Agent 1 — Primary (calls client FROM this number)
AGENT_1_NAME=Your Name
AGENT_1_PHONE=+91XXXXXXXXXX        # Replace with your real E.164 phone number

# Agent 2 — Add when ready (will be dialed if Agent 1 misses)
AGENT_2_NAME=
AGENT_2_PHONE=

# Agent 3 — Future expansion
AGENT_3_NAME=
AGENT_3_PHONE=

# Ring timeout per agent before moving to next (seconds)
AGENT_TIMEOUT_SECONDS=25

# ── GOOGLE SHEETS ───────────────────────────────────────────────────
# 5. Copy Spreadsheet ID from URL: docs.google.com/spreadsheets/d/[THIS_PART]/edit
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_here

# Sheet tab names (must match exactly)
SHEET_CLIENTS_TAB=Clients
SHEET_MISSED_TAB=Missed Calls
SHEET_LOG_TAB=Call Log

# ── WHATSAPP / META ──────────────────────────────────────────────────
META_WA_PHONE_NUMBER_ID=your_phone_number_id_here
META_WA_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxx
META_WA_VOICEMAIL_TEMPLATE=realtor_voicemail_notify
META_WA_MISSED_TEMPLATE=realtor_missed_all
META_WA_BUSINESS_NAME=Your Realty Name

# ── SMTP / EMAIL ─────────────────────────────────────────────────────
# 4. Copy the 16-character password (shown ONCE — save it!)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.business@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM_NAME=Your Name | Realty Team
EMAIL_FROM_ADDRESS=your.business@gmail.com

# ── SERVER CONFIG ────────────────────────────────────────────────────
PORT=3000
DASHBOARD_PORT=3001
LOG_LEVEL=info

# ── DASHBOARD SECURITY ───────────────────────────────────────────────
# REQUIRED: Set a strong random token to protect the manager dashboard.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DASHBOARD_TOKEN=change_me_to_a_strong_random_token

# ── SAFETY ───────────────────────────────────────────────────────────
# IMPORTANT: Default is true (safe). Set to false ONLY when you are ready
# to make real calls with a configured ADB device.
DRY_RUN=true

# Delay between each client call (milliseconds) — 30000 = 30 seconds
CALL_DELAY_MS=30000

# AMD detection: if call connects and hangs up in < this ms, it's voicemail
AMD_VOICEMAIL_THRESHOLD_MS=8000
